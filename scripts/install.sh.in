#!/bin/sh
# Generated by scripts/build-installer.mjs. Review before running.
set -eu
umask 077
if ! command -v node >/dev/null 2>&1; then
  echo 'Mission Control requires Node.js 20+. Install it yourself from nodejs.org, then retry. Nothing installed.' >&2
  exit 1
fi
node -e 'if (Number(process.versions.node.split(".")[0]) < 20) { console.error("Mission Control requires Node.js 20+. Nothing installed."); process.exit(1); }'
command -v curl >/dev/null 2>&1 || { echo 'curl is required. Nothing installed.' >&2; exit 1; }
stage=$(mktemp -d "${TMPDIR:-/tmp}/amc-download.XXXXXXXX")
trap 'rm -rf "$stage"' EXIT HUP INT TERM
# Immutable source revision; hashes are pinned here, not fetched from the same server.
base='https://raw.githubusercontent.com/zxdvd/agent-mission-control/@REF@/adapters'
for file in amc.mjs install.mjs core.mjs storage.mjs; do
  curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --connect-timeout 10 --max-time 60 "$base/$file" -o "$stage/$file"
done
node --input-type=module - "$stage" "$@" <<'AMC_NODE'
import fs from 'node:fs';
import path from 'node:path';
import os from 'node:os';
import { createHash } from 'node:crypto';
import { spawnSync } from 'node:child_process';
const stage = process.argv[2];
const hashes = @HASHES@;
const revision = '@REF@';
let lock, backup, activated = false, configured = false, configuring = false, root, adapters, previous = false;
function fail(message) { throw new Error(message); }
function shellQuote(value) { return "'" + String(value).replaceAll("'", "'\"'\"'") + "'"; }
function regularDirectory(dir) {
  fs.mkdirSync(dir, { recursive: true, mode: 0o700 });
  const stat = fs.lstatSync(dir);
  if (!stat.isDirectory() || stat.isSymbolicLink()) fail('Install/state directory must be a real directory.');
}
function prompt(label, secret = false) {
  let fd;
  try { fd = fs.openSync('/dev/tty', 'r+'); } catch { fail('No interactive terminal. Supply --server, --host-id and --token-file (private 0600 file).'); }
  try {
    fs.writeSync(fd, label);
    const script = secret ? `saved=$(stty -g) || exit 1
trap 'stty "$saved"' EXIT
trap 'exit 130' HUP INT TERM
stty -echo || exit 1
IFS= read -r value || exit 1
printf '%s' "$value"` : `IFS= read -r value || exit 1; printf '%s' "$value"`;
    const result = spawnSync('/bin/sh', ['-c', script], { stdio: [fd, 'pipe', fd], encoding: 'utf8', maxBuffer: 8192 });
    if (result.status !== 0) fail('Input interrupted or unavailable. Retry, or use --token-file.');
    return result.stdout.trim();
  } finally { if (secret) fs.writeSync(fd, '\n'); fs.closeSync(fd); }
}
function run(args, input) {
  const result = spawnSync(process.execPath, [path.join(adapters, 'amc.mjs'), ...args], { input, encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'] });
  if (result.stdout) process.stdout.write(result.stdout);
  if (result.stderr) process.stderr.write(result.stderr);
  if (result.status !== 0) fail('Adapter configuration failed; review local settings before retrying.');
  let report; try { report = JSON.parse(result.stdout); } catch {}
  if (!report?.installed) fail('Hooks were not installed (possibly busy). Retry after other configuration work finishes.');
}
try {
  for (const [file, expected] of Object.entries(hashes)) {
    if (createHash('sha256').update(fs.readFileSync(path.join(stage, file))).digest('hex') !== expected) fail(`Checksum mismatch: ${file}. Nothing installed.`);
  }
  const options = {}, args = process.argv.slice(3);
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--help') { console.log('Usage: install.sh [--server ORIGIN --host-id ID --token-file PATH] [--agent codex|claude] [--state-dir DIR] [--install-dir DIR] [--codex-home DIR] [--claude-home DIR]\nExisting connections are reused. Default: Codex local hooks. Re-run a reviewed newer installer to upgrade.'); process.exit(0); }
    if (!['--server', '--host-id', '--token-file', '--agent', '--state-dir', '--install-dir', '--codex-home', '--claude-home'].includes(args[i]) || !args[i + 1] || args[i + 1].startsWith('--')) fail('Unknown/incomplete option; tokens must never be passed as arguments. Use --help.');
    if (options[args[i]]) fail('Duplicate option.'); options[args[i]] = args[++i];
  }
  const agent = options['--agent'] || 'codex';
  if (!['codex', 'claude'].includes(agent)) fail('Agent must be codex or claude.');
  const state = path.resolve(options['--state-dir'] || process.env.AMC_STATE_DIR || path.join(os.homedir(), '.agent-mission-control'));
  root = path.resolve(options['--install-dir'] || path.join(os.homedir(), '.local/share/agent-mission-control'));
  adapters = path.join(root, 'adapters');
  regularDirectory(root); regularDirectory(state); fs.chmodSync(root, 0o700);
  let config = null;
  try { config = JSON.parse(fs.readFileSync(path.join(state, 'config.json'), 'utf8')); } catch (error) { if (error.code !== 'ENOENT') throw error; }
  const common = ['--state-dir', state, '--agent', agent, ...(agent === 'codex' ? ['--codex-hooks'] : [])];
  for (const option of ['--codex-home', '--claude-home']) if (options[option]) common.push(option, path.resolve(options[option]));
  let command, token;
  if (config) {
    if ((options['--server'] && new URL(options['--server']).origin !== config.server) || (options['--host-id'] && options['--host-id'] !== config.host_id) || (options['--token-file'] && path.resolve(options['--token-file']) !== config.token_file)) fail('Existing connection differs. No changes made; use a separate --state-dir or review it manually.');
    command = ['install', ...common];
  } else {
    const server = options['--server'] || prompt('Mission Control HTTPS origin: ');
    const host = options['--host-id'] || prompt('Host ID (as configured on your server): ');
    command = ['init', '--server', server, '--host-id', host, ...common];
    if (options['--token-file']) command.push('--token-file', path.resolve(options['--token-file']));
    else { token = prompt('Host token (hidden, saved locally): ', true); command.push('--token-stdin'); }
  }
  lock = path.join(root, '.install-lock');
  try { fs.mkdirSync(lock, { mode: 0o700 }); } catch { lock = null; fail('Another installer is running, or a previous interrupted install left .install-lock. Review before retrying.'); }
  const versionFile = path.join(root, 'version.json');
  try { const stat = fs.lstatSync(versionFile); if (!stat.isFile() || stat.isSymbolicLink()) fail('version.json must be a regular file.'); } catch (error) { if (error.code !== 'ENOENT') throw error; }
  if (fs.existsSync(adapters)) {
    const stat = fs.lstatSync(adapters);
    if (!stat.isDirectory() || stat.isSymbolicLink()) fail('Adapter directory must be a real directory.');
    if (fs.readdirSync(adapters).some(name => !Object.hasOwn(hashes, name))) fail('Unexpected files in adapter directory; preserve and review them manually.');
  }
  const next = fs.mkdtempSync(path.join(root, '.next-'));
  try { for (const file of Object.keys(hashes)) fs.copyFileSync(path.join(stage, file), path.join(next, file)); }
  catch (error) { fs.rmSync(next, { recursive: true, force: true }); throw error; }
  backup = path.join(root, '.previous-adapters');
  if (fs.existsSync(backup)) { fs.rmSync(next, { recursive: true }); fail('Previous interrupted upgrade needs review: .previous-adapters exists.'); }
  if (fs.existsSync(adapters)) { fs.renameSync(adapters, backup); previous = true; }
  fs.renameSync(next, adapters); activated = true;
  configuring = true;
  run(command, token === undefined ? undefined : `${token}\n`); token = undefined; configured = true;
  const versionTemp = path.join(root, '.version-next');
  fs.writeFileSync(versionTemp, `${JSON.stringify({ revision, hashes }, null, 2)}\n`, { mode: 0o600, flag: 'wx' });
  fs.renameSync(versionTemp, versionFile);
  if (previous) fs.rmSync(backup, { recursive: true });
  activated = false;
  console.log(`Installed verified adapter revision ${revision}.\nAdapter: ${path.join(adapters, 'amc.mjs')}\nState: ${state}\nNo network heartbeat was sent. Review/trust hooks in your agent and test a real App session.\nUninstall hooks: node ${shellQuote(path.join(adapters, 'amc.mjs'))} uninstall --state-dir ${shellQuote(state)}\nUninstall retains connection/token/queue files; revoke the server credential separately.`);
} catch (error) {
  if (!configured) {
    if (activated && (previous || !configuring)) fs.rmSync(adapters, { recursive: true, force: true });
    else if (activated) console.error('Verified adapters retained because configuration may be partially written. Review settings and retry.');
    if (previous && fs.existsSync(backup)) fs.renameSync(backup, adapters);
  } else console.error('Hooks were configured; verified adapters retained. Review version metadata/previous backup before retrying.');
  console.error(`Mission Control installer: ${error.message}`); process.exitCode = 1;
} finally { if (lock) fs.rmdirSync(lock); }
AMC_NODE
