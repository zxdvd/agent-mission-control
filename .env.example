# Copy ONLY for local loopback development. Never expose or deploy LOCAL_DEV=true.
LOCAL_DEV=true
# Production username is a non-secret Worker variable, managed by the deploy workflow.
# DASHBOARD_USERNAME=<your chosen login name>
# Production: configure these names as Cloudflare Worker Secrets, not Git variables.
# DASHBOARD_PASSWORD_HASH=<output from scripts/password-hash.mjs>
# SESSION_SECRET=<independent random secret, at least 32 characters>
# AGENT_TOKENS_JSON=[{"host_id":"host-one","name":"Workstation","token_hash":"<sha256 hex>"}]
# An empty fixed-token list disables all ingestion until hosts are configured.
AGENT_TOKENS_JSON=[]
